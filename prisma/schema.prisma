// The svrz_rc database, like for like with the PocketBase collections it
// replaced on 10.10.2026 (docs/postgres-prisma-plan.md). Column names, types
// and empty values are PocketBase's on purpose — text is NOT NULL DEFAULT '',
// numbers 0, booleans false, JSON nullable and stored verbatim (`json`, not
// `jsonb`: key order and odd escapes survive) — because phase 1 swaps the
// store under unchanged queries (server/db/records.ts). The field order and
// types are mirrored in server/db/collections.ts; e2e/db-schema.spec.ts keeps
// the two in step.
//
// ⚠ The database must compare text byte-wise like SQLite did: created with
// the builtin C.UTF-8 locale (deploy/hetzner/docker-compose.yml); the API
// refuses to start on anything else (server/db/client.ts).

generator client {
  provider     = "prisma-client"
  output       = "../server/db/generated"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id String @id @db.VarChar(15)
  match_no String @default("")
  league String @default("")
  match_date String @default("")
  location String @default("")
  home_team String @default("")
  away_team String @default("")
  first_referee String @default("")
  second_referee String @default("")
  first_line_judge String @default("")
  second_line_judge String @default("")
  assigned_rc String @default("")
  feedback_closed_roles Json? @db.Json
  source_payload Json? @db.Json
  game_result String @default("")
  created DateTime? @default(now()) @db.Timestamptz(3)
  updated DateTime? @default(now()) @updatedAt @db.Timestamptz(3)
  is_rsv_game Boolean @default(false)
  is_rd_game Boolean @default(false)
  is_ld_game Boolean @default(false)
  maps_url String @default("")
  external_id String @default("")
  assigned_rc_id String @default("")
  first_referee_id String @default("")
  second_referee_id String @default("")
  assigned_at String @default("")
  assigned_via String @default("")
  handed_over Json? @db.Json
  /// PocketBase listed rows in SQLite rowid order when no sort was given and
  /// broke sort ties the same way; this keeps that order (never returned).
  seq Int @default(autoincrement()) @map("_seq")
  referee_coach_feedbacks_game RefereeCoachFeedback[] @relation("referee_coach_feedbacks_game")
  observations_game Observation[] @relation("observations_game")
  rc_game_notes_game RcGameNote[] @relation("rc_game_notes_game")
  @@index([match_no])
  @@index([external_id])
  @@index([match_date])
  @@index([assigned_rc_id])
  @@map("games")
}

