model RefereeCoachFeedback {
  id String @id @db.VarChar(15)
  game String? @db.VarChar(15)
  game_rec Game? @relation("referee_coach_feedbacks_game", fields: [game], references: [id], onDelete: SetNull, onUpdate: Cascade)
  coachee String? @db.VarChar(15)
  coachee_rec Coachee? @relation("referee_coach_feedbacks_coachee", fields: [coachee], references: [id], onDelete: SetNull, onUpdate: Cascade)
  rc_name String @default("")
  role_assessed String @default("")
  feedback_json Json? @db.Json
  submitted_at String @default("")
  pdf_file String @default("")
  created DateTime? @default(now()) @db.Timestamptz(3)
  updated DateTime? @default(now()) @updatedAt @db.Timestamptz(3)
  rc_id String @default("")
  submission_key String @default("")
  /// PocketBase listed rows in SQLite rowid order when no sort was given and
  /// broke sort ties the same way; this keeps that order (never returned).
  seq Int @default(autoincrement()) @map("_seq")
  president_notes_feedback PresidentNote? @relation("president_notes_feedback")
  @@index([game])
  @@index([coachee])
  @@index([submitted_at])
  @@index([submission_key])
  @@map("referee_coach_feedbacks")
}

model Observation {
  id String @id @db.VarChar(15)
  coachee String? @db.VarChar(15)
  coachee_rec Coachee? @relation("observations_coachee", fields: [coachee], references: [id], onDelete: SetNull, onUpdate: Cascade)
  referee_coach String? @db.VarChar(15)
  referee_coach_rec RefereeCoach? @relation("observations_referee_coach", fields: [referee_coach], references: [id], onDelete: SetNull, onUpdate: Cascade)
  game String? @db.VarChar(15)
  game_rec Game? @relation("observations_game", fields: [game], references: [id], onDelete: SetNull, onUpdate: Cascade)
  coachee_function String @default("")
  grades Json? @db.Json
  game_level String @default("")
  promotion String @default("")
  motivation String @default("")
  sr_goal String @default("")
  game_result String @default("")
  remarks String @default("")
  second_observation Boolean @default(false)
  created DateTime? @default(now()) @db.Timestamptz(3)
  updated DateTime? @default(now()) @updatedAt @db.Timestamptz(3)
  /// PocketBase listed rows in SQLite rowid order when no sort was given and
  /// broke sort ties the same way; this keeps that order (never returned).
  seq Int @default(autoincrement()) @map("_seq")
  @@index([game])
  @@index([coachee])
  @@index([referee_coach])
  @@map("observations")
}

