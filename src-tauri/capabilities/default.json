{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the app's own pages may ask of the shell: open a link outside the app, update and restart itself, use Bluetooth for the notebook's camera, and (Android) ask the phone for a passkey.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "tel:*"
        },
        {
          "url": "sms:*"
        }
      ]
    },
    "process:allow-restart",
    "blec:default",
    "passkey:allow-create",
    "passkey:allow-get"
  ]
}
