<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Without it the WebView never updates navigator.onLine: the installed app
         showed no offline banner and mailed every lost signal as an outage
         (0 net.offline lines across 22 native sessions, audit 22.10.2026). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Phone notifications (PushPlugin.kt): Android 13+ asks the coach first. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.svrz_rc"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!-- Passkeys (PasskeyPlugin.kt): the app's half of the link with
             svrz-rc.openvolley.app. The site's half is
             public/.well-known/assetlinks.json; Google Play services wants
             both before it hands the app the site's passkeys — with only the
             site's, sign-in failed "RP ID cannot be validated" (1.4.5). -->
        <meta-data android:name="asset_statements" android:resource="@string/asset_statements" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phone notifications: messages from the coach's UnifiedPush
             distributor, or the built-in one through Play services
             (PushStore.kt, PushPlugin.kt). -->
        <service
            android:name=".SvrzPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
