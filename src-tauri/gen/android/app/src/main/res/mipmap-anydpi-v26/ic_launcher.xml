<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon from Android 8 on: the app logo (OpenVolley's ball and a
     referee whistle) on white, scaled into the adaptive icon's 66dp safe zone.
     The foregrounds come from brand/adaptive-foreground.svg through
     scripts/make-brand-assets.py, which also keeps the copy in icons/android.
     Don't regenerate them with `tauri icon`: it scales the whole square source
     to the 108dp layer, and circle or squircle masks cut its edges off. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
