<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon from Android 8 on. The foreground is the Swiss Volley
     logo shrunk into the adaptive icon's 66dp safe zone: `tauri icon` scales the
     whole square source to the 108dp layer, and launchers that mask to a circle
     or squircle cut the ends of the wordmark off. Re-running `tauri icon` brings
     that back; the padded foregrounds are kept in icons/android as well. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
